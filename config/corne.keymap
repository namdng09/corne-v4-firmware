#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
};

&mmv {
    time-to-max-speed-ms = <200>;
    acceleration-exponent = <2>;
};

&msc {
    time-to-max-speed-ms = <200>;
    acceleration-exponent = <3>;
};

/ {
    macros {
        pretmux: ctrlAP {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(A) &kp P>;
            label = "CTRLAP";
        };

        nexttmux: ctrlAN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(A) &kp N>;
            label = "CTRLAN";
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "Home Row Mod Left";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "Home Row Mod Right";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB         &kp Q         &lt 5 W            &lt 6 E   &kp R      &kp T    &kp Y          &kp U      &kp I          &kp O               &kp P                 &mt LEFT_ALT LEFT_BRACKET
&kp ESC         &hml LCTRL A  &hml LEFT_SHIFT S  &lt 4 D   &lt 3 F    &kp G    &kp H          &kp J      &kp K          &hmr RIGHT_SHIFT L  &hmr RCTRL SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &kp Z         &kp X              &kp C     &kp V      &kp B    &kp N          &kp M      &kp COMMA      &kp DOT             &kp FSLH              &kp RIGHT_SHIFT
                                                 &kp LGUI  &kp SPACE  &mo 2    &kp RG(SPACE)  &kp SPACE  &kp RIGHT_WIN
            >;
        };

        dvorak {
            display-name = "dvorak";
            bindings = <
&kp TAB         &kp SINGLE_QUOTE  &lt 5 COMMA        &lt 6 DOT  &kp P      &kp Y    &kp F          &kp G      &kp C          &kp R               &kp L                 &mt LEFT_ALT SLASH
&kp ESC         &hml LCTRL A      &hml LEFT_SHIFT O  &lt 4 E    &lt 3 U    &kp I    &kp D          &kp H      &kp T          &hmr RIGHT_SHIFT N  &hmr RIGHT_CONTROL S  &kp MINUS
&kp LEFT_SHIFT  &kp SEMI          &kp Q              &kp J      &kp K      &kp X    &kp B          &kp M      &kp W          &kp V               &kp Z                 &kp RIGHT_SHIFT
                                                     &kp LGUI   &kp SPACE  &mo 2    &kp RG(SPACE)  &kp SPACE  &kp RIGHT_WIN
            >;
        };

        mouse {
            bindings = <
&trans  &kp HOME  &kp PAGE_DOWN  &kp PG_UP     &kp END       &trans    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans  &bt BT_CLR
&trans  &trans    &kp K_MUTE     &kp C_VOL_DN  &kp C_VOL_UP  &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &bt BT_SEL 0
&trans  &trans    &kp K_PP       &kp K_PREV    &kp K_NEXT    &trans    &trans          &mkp LCLK       &mkp RCLK     &trans           &trans  &bt BT_SEL 1
                                 &trans        &trans        &trans    &trans          &trans          &trans
            >;
        };

        misc {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans    &kp LG(LA(PG_UP))  &kp LG(PG_UP)         &kp LG(PAGE_DOWN)  &kp LG(LA(PAGE_DOWN))  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans    &kp LC(BACKSPACE)  &kp BACKSPACE         &kp LS(ENTER)      &trans                 &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans    &kp DEL            &kp LA(SINGLE_QUOTE)  &trans             &trans                 &trans  &trans
                        &trans  &kp ENTER  &trans    &trans             &kp RET               &trans
            >;
        };

        arrows {
            bindings = <
&trans  &trans  &trans  &trans  &trans       &trans    &trans    &trans           &trans       &trans     &kp K_FORWARD  &trans
&trans  &trans  &trans  &trans  &trans       &trans    &kp LEFT  &kp DOWN         &kp UP       &kp RIGHT  &kp K_BACK     &trans
&trans  &trans  &trans  &trans  &trans       &trans    &trans    &kp LC(LS(TAB))  &kp LC(TAB)  &pretmux   &nexttmux      &trans
                        &trans  &kp K_PASTE  &trans    &trans    &kp K_CUT        &trans
            >;
        };

        marks {
            display-name = "Raise Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans    &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp GRAVE      &kp TILDE  &kp LBKT   &tog 0
&trans  &trans  &trans  &trans  &trans      &trans    &kp MINUS       &kp EQUAL        &kp UNDER      &kp PLUS   &kp COLON  &tog 1
&trans  &trans  &trans  &trans  &trans      &trans    &kp LPAR        &kp RPAR         &kp BACKSLASH  &kp PIPE   &kp RBKT   &trans
                        &trans  &kp K_COPY  &trans    &trans          &kp K_COPY       &trans
            >;
        };

        number {
            bindings = <
&trans  &trans  &trans  &trans  &kp LG(V)      &trans    &trans  &kp N7        &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans  &kp LG(LS(S))  &trans    &trans  &kp N4        &kp N5  &kp N6  &kp N0  &trans
&trans  &trans  &trans  &trans  &trans         &trans    &trans  &kp N1        &kp N2  &kp N3  &trans  &trans
                        &trans  &kp K_SELECT   &trans    &trans  &kp K_SELECT  &trans
            >;
        };
    };
};
