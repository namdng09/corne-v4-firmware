#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        pretmux: ctrlAP {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(A) &kp P>;
            label = "CTRLAP";
        };

        nexttmux: ctrlAN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(A) &kp N>;
            label = "CTRLAN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB           &lt 6 Q      &lt 3 W           &lt 5 E   &kp R      &kp T                &kp Y          &kp U      &kp I          &kp O              &kp P                   &kp BSPC
&kp ESC           &mt RCTRL A  &mt LEFT_SHIFT S  &lt 2 D   &lt 1 F    &kp G                &kp H          &kp J      &kp K          &mt RIGHT_SHIFT L  &mt RIGHT_CONTROL SEMI  &kp SQT
&lt 7 LEFT_SHIFT  &kp Z        &kp X             &kp C     &lt 4 V    &kp B                &kp N          &kp M      &kp COMMA      &kp DOT            &kp FSLH                &kp LEFT_SHIFT
                                                 &kp LGUI  &kp SPACE  &kp LC(BACKSPACE)    &kp BACKSPACE  &kp SPACE  &kp RIGHT_WIN
            >;
        };

        misc {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans    &trans                &trans         &trans         &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans    &kp LC(BACKSPACE)     &kp BACKSPACE  &kp LS(ENTER)  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans    &kp LA(SINGLE_QUOTE)  &kp DEL        &trans         &trans  &trans  &trans
                        &trans  &kp ENTER  &trans    &trans                &kp RET        &trans
            >;
        };

        arrows {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans    &trans           &trans       &trans  &trans     &kp K_FORWARD  &trans
&trans  &trans  &trans  &trans  &trans     &trans    &kp LEFT         &kp DOWN     &kp UP  &kp RIGHT  &kp K_BACK     &trans
&trans  &trans  &trans  &trans  &trans     &trans    &kp LS(LC(TAB))  &kp LC(TAB)  &trans  &trans     &trans         &trans
                        &trans  &kp LC(V)  &trans    &trans           &kp LC(V)    &trans
            >;
        };

        marks {
            display-name = "Raise Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR   &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans     &trans       &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans  &trans    &trans     &trans       &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LGUI  &kp LC(C)  &trans       &kp RET    &kp LC(C)  &kp RALT
            >;
        };

        audios {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp C_AC_HOME     &kt PAGE_DOWN   &kp PAGE_UP   &kt END  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp K_MUTE        &kp C_VOL_DN    &kp C_VOL_UP  &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp K_PLAY_PAUSE  &kp C_PREVIOUS  &kp K_NEXT    &trans   &trans  &trans
                        &trans  &trans  &trans    &trans            &trans          &trans
            >;
        };

        number {
            bindings = <
&trans  &trans  &trans  &trans  &kp LG(V)      &trans    &trans  &kp N7     &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans  &kp LG(LS(S))  &trans    &trans  &kp N4     &kp N5  &kp N6  &kp N0  &trans
&trans  &trans  &trans  &trans  &trans         &trans    &trans  &kp N1     &kp N2  &kp N3  &trans  &trans
                        &trans  &kp LC(A)      &trans    &trans  &kp LC(A)  &trans
            >;
        };

        hypr {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans    &kp LG(LA(PG_UP))  &kp LG(PG_UP)   &kp LG(PG_DN)  &kp LG(LA(PG_DN))  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans    &msc SCRL_LEFT     &msc SCRL_DOWN  &msc SCRL_UP   &msc SCRL_RIGHT    &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans    &pretmux           &nexttmux       &trans         &trans             &trans  &trans
                        &trans  &kp LC(X)  &trans    &trans             &kp LC(X)       &trans
            >;
        };

        e {
            display-name = "Lower Layer";
            bindings = <
&kp TAB     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6    &kp N7    &kp N8    &kp N9     &kp N0  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans  &kp DEL
&kp LSHFT   &trans        &trans        &trans        &trans        &trans          &trans    &trans    &trans    &trans     &trans  &trans
                                        &kp LGUI      &trans        &kp SPACE       &kp RET   &trans    &kp RALT
            >;
        };
    };
};
